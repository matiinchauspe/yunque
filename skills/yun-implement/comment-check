#!/usr/bin/env bash
# comment-check <base> [<dir> [<head>]] — flags the comment lines a change adds.
# Without <head>, uncommitted and untracked work counts too.
# Exit 0 clean, 1 flagged, 2 the change could not be read.

set -uo pipefail

base="${1:-}"
dir="${2:-.}"
head="${3:-}"
[[ -n "$base" ]] || { echo "usage: comment-check <base> [<dir> [<head>]]" >&2; exit 2; }
for ref in "$base" ${head:+"$head"}; do
  git -C "$dir" rev-parse --verify --quiet "$ref^{commit}" >/dev/null \
    || { echo "comment-check: '$ref' does not resolve in $dir" >&2; exit 2; }
done

added="$(mktemp)"
trap 'rm -f "$added"' EXIT

# One "file<TAB>line<TAB>text" row per added line, new-side line numbers.
git -C "$dir" diff -U0 --no-color --no-ext-diff "$base" ${head:+"$head"} -- . | awk '
  /^\+\+\+ / { f = substr($0, 7); next }
  /^@@ /     { split($3, a, ","); n = substr(a[1], 2) + 0; next }
  /^\+/      { print f "\t" n "\t" substr($0, 2); n++ }
' >"$added" || { echo "comment-check: git diff failed" >&2; exit 2; }
while IFS= read -r f; do
  awk -v f="$f" '{ print f "\t" NR "\t" $0 }' "$dir/$f" >>"$added"
done < <([[ -n "$head" ]] || git -C "$dir" ls-files --others --exclude-standard)

# Extensionless files that open on a shebang read as #-comment files.
shebang="$(mktemp)"
trap 'rm -f "$added" "$shebang"' EXIT
cut -f1 "$added" | sort -u | while IFS= read -r f; do
  [[ "${f##*/}" != *.* && -f "$dir/$f" ]] && head -c2 "$dir/$f" | grep -q '#!' && echo "$f"
done >"$shebang"

awk -F'\t' '
  FILENAME == ARGV[1] { script[$0] = 1; next }
  function family(f,   e) {
    if (f in script) return "hash"
    e = tolower(f); sub(/.*\./, "", e)
    if (e ~ /^(js|jsx|ts|tsx|mjs|cjs|mts|cts|go|rs|java|kt|kts|swift|c|cc|cpp|h|hpp|cs|scala|dart|php|css|scss|less|vue|svelte|astro)$/) return "slash"
    if (e ~ /^(py|rb|sh|bash|zsh|yml|yaml|toml|r|pl|ex|exs)$/) return "hash"
    if (e ~ /^(sql|lua|hs|elm)$/) return "dash"
    if (e ~ /^(html|htm|xml)$/) return "markup"
    return ""
  }
  # The comment text of a line, or "" when the line carries none.
  function comment(fam, s,   t) {
    if (fam == "slash" || fam == "markup") {
      if (match(s, /^[ \t]*(\{\/\*|\/\/+|\/\*+|\*\/|\*|<!--)/)) t = substr(s, RLENGTH + 1)
      else if (fam == "slash" && match(s, /[ \t]\/\/[ \t]/)) t = substr(s, RSTART + 3)
      else return ""
    } else if (fam == "hash") {
      if (s ~ /^[ \t]*#!/) return ""
      if (match(s, /^[ \t]*#+/)) t = substr(s, RLENGTH + 1); else return ""
    } else if (fam == "dash") {
      if (match(s, /^[ \t]*--+/)) t = substr(s, RLENGTH + 1); else return ""
    } else return ""
    sub(/(\*\/\}?|-->)[ \t]*$/, "", t); gsub(/^[ \t]+|[ \t]+$/, "", t)
    return t
  }
  function flag(k, why) { print file[k] ":" line[k] "\t" why "\t" text[k]; hits++ }
  {
    fam = family($1); t = comment(fam, $3)
    if (t == "") { run = 0; next }
    n++; file[n] = $1; line[n] = $2; text[n] = t
    low = tolower(t)
    if (low ~ /(^|[^a-z])(ticket|adr|decision|spec|issue|pr|ac|q)[ -]?#?[0-9]+|#[0-9][0-9][0-9]|docs\/|\.md([^a-z]|$)|glossary|research §|per (the )?spec|\(spec\)/) flag(n, "pointer")
    else if (low ~ /same (as|[a-z-]+ as|convention|rule|reason|shape)|reuses? |mirrors? |see (the )?(doc|comment)|as [a-z_]+\(\) does/) flag(n, "cross-ref")
    else if (low ~ /20[0-9][0-9]-[0-9][0-9]|measured|used to |previously|no longer|legacy|review fix|found (on|in|that|20)|v[0-9]+\.[0-9]+/) flag(n, "history")
    else if (length(t) > 120) flag(n, "long")
    run = ($1 == runfile && $2 == runline + 1) ? run + 1 : 1
    runfile = $1; runline = $2
    if (run == 4) flag(n, "block")
    key = tolower(t); gsub(/[^a-z0-9 ]/, "", key); gsub(/ +/, " ", key)
    if (split(key, w, " ") >= 5) { if (key in seen) flag(n, "repeat of " seen[key]); else seen[key] = $1 ":" $2 }
  }
  END { exit hits > 0 }
' "$shebang" "$added"
