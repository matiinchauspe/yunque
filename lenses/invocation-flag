#!/usr/bin/env bash
# Lens: invocation-flag
#
# Question: does every skill's invocation mode, read from its FRONTMATTER ONLY,
# agree with what the AGENTS.md index declares?
#
# Two independently-derived sources are compared. Neither is trusted over the other:
# a disagreement is reported, not resolved.
#
# Usage: lenses/invocation-flag [root]   (root defaults to the workspace root)
# Exit:  0 = clean · 1 = findings · 2 = the lens could not run

set -uo pipefail

root="${1:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
index="$root/AGENTS.md"
skills="$root/skills"

[ -f "$index" ]  || { echo "invocation-flag: no AGENTS.md under $root" >&2; exit 2; }
[ -d "$skills" ] || { echo "invocation-flag: no skills/ under $root"   >&2; exit 2; }

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

# --- source 1: the frontmatter, and ONLY the frontmatter ------------------
# The string also appears in prose that documents the flag. Reading the whole
# file matches that prose and manufactures a finding — measured twice, three
# days apart, by two different agents who never met. Reading the whole file is the
# instrument that fails here, not the skill it reports on.
for f in "$skills"/yun-*/SKILL.md; do
  [ -f "$f" ] || continue
  name="$(basename "$(dirname "$f")")"
  if awk 'NR==1 && $0 == "---" { inf=1; next } inf && $0 == "---" { exit } inf' "$f" \
     | rg -q '^disable-model-invocation:[[:space:]]*true[[:space:]]*$'; then
    printf '%s\t%s\n' "$name" "user"
  else
    printf '%s\t%s\n' "$name" "auto"
  fi
done > "$work/from-frontmatter"

# --- source 2: the index table in AGENTS.md -------------------------------
awk -F'|' '
  /^\| `yun-/ {
    name = $2; gsub(/[` \t]/, "", name)
    inv  = $(NF-1); gsub(/[ \t]/, "", inv)
    if (inv == "user" || inv == "auto") printf "%s\t%s\n", name, inv
  }
' "$index" > "$work/from-index"

# --- compare --------------------------------------------------------------
findings="$(awk -F'\t' '
  NR == FNR { fm[$1] = $2; order[++n] = $1; next }
  { ix[$1] = $2 }
  END {
    for (i = 1; i <= n; i++) {
      s = order[i]
      if (!(s in ix))
        printf "UNLISTED  %s  in skills/ but absent from the AGENTS.md index\n", s
      else if (fm[s] != ix[s])
        printf "MISMATCH  %s  frontmatter says %s, index says %s\n", s, fm[s], ix[s]
    }
    for (s in ix)
      if (!(s in fm))
        printf "DANGLING  %s  in the AGENTS.md index but no skills/%s/SKILL.md\n", s, s
  }
' "$work/from-frontmatter" "$work/from-index" | sort)"

count="$(awk 'END { print NR }' "$work/from-frontmatter")"

if [ -n "$findings" ]; then
  printf '%s\n' "$findings"
  exit 1
fi

echo "CLEAN  $count skills, index agrees"
