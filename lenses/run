#!/usr/bin/env bash
# Runs every lens — each against its own fixtures FIRST, then against the harness.
#
# A lens whose fixtures fail is a BROKEN INSTRUMENT, and its reading of the harness
# is discarded rather than printed. A broken check does not disable a verification;
# it invents one, wearing the costume of a rigorous finding with file names
# attached. That has happened twice here, and this gate is what stops a third.
#
# Usage: lenses/run [lens-name ...]   (default: every lens)
# Exit:  0 = every lens clean · 1 = findings in the harness · 2 = a lens is broken

set -uo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "$here/.." && pwd)"

skipped=""   # files that ARE lenses but cannot run — never silently dropped

if [ "$#" -gt 0 ]; then
  lenses=("$@")
else
  lenses=()
  for l in "$here"/*; do
    [ -f "$l" ] || continue                     # fixtures/ is a directory
    b="$(basename "$l")"
    case "$b" in run | *.md) continue ;; esac   # the runner itself, and its prose
    if [ -x "$l" ]; then
      lenses+=("$b")
    else
      # A lens that lost its executable bit used to VANISH from the run without
      # a single message, while the verdict at the bottom went on speaking for
      # "every lens". Silent coverage loss reads exactly like coverage, and it
      # is the more dangerous of the two because it reads BETTER: fewer lines,
      # same green word. Measured by chmod -x on a working lens.
      skipped="${skipped}${b} "
    fi
  done
fi

uncalibrated=0   # a lens failed its own fixtures — it is measuring wrong
errored=0        # a lens could not run at all
findings=0       # the harness has defects

# Nothing to measure is not a clean result. Without this, an empty `lenses/` — or
# a checkout where every lens arrived without its executable bit — walks straight
# to the CLEAN verdict at the bottom, which would then be speaking for a set of
# zero.
if [ "${#lenses[@]}" -eq 0 ] && [ -z "$skipped" ]; then
  echo "run: no lenses found under $here — nothing could be measured." >&2
  exit 2
fi

# `${arr[@]+"${arr[@]}"}` and not `"${lenses[@]}"`: bash 3.2, which is what macOS
# ships, treats the plain form on an EMPTY array as an unbound variable under
# `set -u`. With every lens non-executable this loop died with `lenses[@]:
# unbound variable` and exit 1 — a crash wearing the exit code that means
# "findings in the harness". Measured on bash 3.2.57.
for lens in ${lenses[@]+"${lenses[@]}"}; do
  script="$here/$lens"
  [ -x "$script" ] || { echo "run: no such lens: $lens" >&2; errored=1; continue; }

  echo "── $lens"

  # --- calibrate: every fixture is a planted case the lens MUST read correctly
  fixdir="$here/fixtures/$lens"
  calibrated=1
  # Cases are COUNTED, never inferred from the directory existing. A
  # `fixtures/<lens>/` that is present but holds no case with an `expected` file
  # ran this loop zero times and left `calibrated` at 1 — an uncalibrated lens
  # whose reading was then printed as trustworthy, which is the exact failure
  # this gate exists to prevent. The way in is the suite's own "Adding a lens"
  # step 2 → step 3, where the directory is already there and still empty.
  # Absent and empty are one verdict.
  cases=0
  if [ -d "$fixdir" ]; then
    for fix in "$fixdir"/*/; do
      [ -f "$fix/expected" ] || continue
      cases=$((cases + 1))
      name="$(basename "$fix")"
      actual="$("$script" "${fix%/}" 2>&1)"; code=$?
      expected="$(awk 'NF || NR < 1' "$fix/expected")"
      if [ "$expected" = "${expected#CLEAN}" ]; then want=1; else want=0; fi

      if [ "$actual" = "$expected" ] && [ "$code" -eq "$want" ]; then
        echo "   fixture ok    $name"
      else
        calibrated=0
        echo "   FIXTURE FAIL  $name"
        echo "     expected (exit $want):"; printf '       %s\n' "$expected"
        echo "     actual   (exit $code):"; printf '       %s\n' "$actual"
      fi
    done
  fi

  if [ "$cases" -eq 0 ]; then
    calibrated=0
    echo "   NO FIXTURES — an uncalibrated lens is not trusted"
  fi

  if [ "$calibrated" -eq 0 ]; then
    echo "   BROKEN INSTRUMENT — its reading of the harness is discarded, not reported"
    uncalibrated=1
    continue
  fi

  # --- measure: only now is the reading worth anything
  out="$("$script" "$root" 2>&1)"; code=$?
  printf '   %s\n' "$out"
  [ "$code" -eq 1 ] && findings=1
  if [ "$code" -gt 1 ]; then
    echo "   COULD NOT RUN — calibrated, but it failed against the harness itself"
    errored=1
  fi
done

# Reported as loudly as a lens that ran, because the alternative is a shorter,
# greener report that covers less and says nothing about the difference.
for b in $skipped; do
  echo "── $b"
  echo "   NOT EXECUTABLE — a lens that cannot run measured nothing.  chmod +x lenses/$b"
  errored=1
done

echo
# The two failure modes are NOT the same and must never share a message: an
# uncalibrated lens measures confidently and wrongly, an errored one measures
# nothing. Reporting the second as the first is the same defect this suite exists
# to catch, committed by the suite itself.
if [ "$uncalibrated" -eq 1 ]; then
  echo "UNCALIBRATED — a lens failed its own fixtures. Fix the LENS before believing it."
  exit 2
elif [ "$errored" -eq 1 ]; then
  echo "ERRORED — a lens could not run. Nothing was measured; this is not a clean result."
  exit 2
elif [ "$findings" -eq 1 ]; then
  echo "FINDINGS — every lens is calibrated, and the harness has defects above."
  exit 1
else
  echo "CLEAN — every lens calibrated, no findings."
fi
